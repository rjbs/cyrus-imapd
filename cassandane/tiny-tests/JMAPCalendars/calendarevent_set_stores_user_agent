#!perl
use Cassandane::Tiny;

# CalDAV records the writing client's HTTP User-Agent in the stored event
# message; CalendarEvent/set should do the same by plumbing the JMAP request's
# User-Agent through to caldav_store_resource. -- claude, 2026-06-11
sub test_calendarevent_set_stores_user_agent
    :min_version_3_9
    :MagicPlus
    ($self)
{
    my $user = $self->default_user;
    my $jmap = $user->jmap;
    my $default_cal_id = $user->calendars->default->id;

    my $agent = 'Cassandane-JMAP-Client/9.9';
    $jmap->ua->lwp->agent($agent);

    xlog $self, "create an event via CalendarEvent/set";
    my $res = $jmap->CallMethods([
        ['CalendarEvent/set', { create => { e1 => {
            calendarIds => { $default_cal_id => JSON::true },
            title => "an event",
            start => "2026-06-11T09:00:00",
            timeZone => "Etc/UTC",
            duration => "PT1H",
        }}}, "R1"],
    ]);
    $self->assert_not_null($res->[0][1]{created}{e1});

    xlog $self, "the stored event message carries the JMAP client's User-Agent";
    my $raw = $self->_fetch_dav_message($user, qr{#calendars.*Default}i);
    $self->assert_matches(qr/^User-Agent:\s*\Q$agent\E\s*$/im, $raw);
}
