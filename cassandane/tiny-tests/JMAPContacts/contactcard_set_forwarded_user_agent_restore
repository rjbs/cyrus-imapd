#!perl
use Cassandane::Tiny;

# A WS connection is shared across requests, and forwardedHeaders is applied to
# req_hdrs only for the duration of the frame that carries it.  A later frame
# on the same connection that omits it must NOT inherit the previous frame's
# forwarded User-Agent. -- claude, 2026-06-12
sub test_contactcard_set_forwarded_user_agent_restore
    :min_version_3_9
    :MagicPlus
    ($self)
{
    my $user = $self->default_user;
    my $jmap_ws = $user->jmap_ws;

    my $fwd_agent = 'Forwarded-Client/9.9';

    my $uid_fwd = '11111111-1111-1111-1111-111111111111';
    my $uid_plain = '22222222-2222-2222-2222-222222222222';

    my $using = [ 'urn:ietf:params:jmap:core', 'urn:ietf:params:jmap:contacts' ];

    xlog $self, "frame 1: create a card, forwarding a User-Agent";
    $jmap_ws->request({
        using => $using,
        methodCalls => [
            ['ContactCard/set', { create => { c1 => {
                '@type' => 'Card',
                version => '1.0',
                name => { full => "Forwarded Card" },
                uid => $uid_fwd,
            }}}, "R1"],
        ],
        forwardedHeaders => { 'User-Agent' => $fwd_agent },
    })->assert_successful;

    xlog $self, "frame 2: another card on the same connection, no forwardedHeaders";
    $jmap_ws->request({
        using => $using,
        methodCalls => [
            ['ContactCard/set', { create => { c2 => {
                '@type' => 'Card',
                version => '1.0',
                name => { full => "Plain Card" },
                uid => $uid_plain,
            }}}, "R1"],
        ],
    })->assert_successful;

    my @raw = $self->_fetch_dav_messages($user, qr{#addressbooks.*Default}i);
    my ($fwd_msg) = grep { /\Q$uid_fwd\E/ } @raw;
    my ($plain_msg) = grep { /\Q$uid_plain\E/ } @raw;
    $self->assert_not_null($fwd_msg);
    $self->assert_not_null($plain_msg);

    xlog $self, "the forwarding frame's card carries the forwarded User-Agent";
    $self->assert_matches(qr/^User-Agent:\s*\Q$fwd_agent\E\s*$/im, $fwd_msg);

    xlog $self, "the later frame's card did not inherit the forwarded User-Agent";
    $self->assert_does_not_match(qr/\Q$fwd_agent\E/i, $plain_msg);
}
